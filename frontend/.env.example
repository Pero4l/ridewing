# Public URL of the RideWing API — baked into the client bundle at build time.
#
# HTTP calls go through a same-origin rewrite (see next.config.ts), so this value
# is used for the Socket.IO connection and direct upload URLs.
NEXT_PUBLIC_API_URL=http://localhost:4000

# VAPID public key the browser uses to subscribe to Web Push. Must match the
# backend's VAPID_PUBLIC_KEY (see backend/.env). Leave empty to disable push.
# Generate a fresh pair with:
#   npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=