# Dependencies
node_modules/

# Secrets — real credentials must never be committed.
.env
.env.local
.env.*.local
# Any other .env.<name> variant is a real secret too (production, staging, ...).
.env.*
# ...but the committed template is the exception, and must stay *last* so it wins.
!.env.example

# Logs
logs/
*.log
npm-debug.log*

# Testing
coverage/

# OS / editor
.DS_Store
*.swp

#script
fix-follows.js