# RideWing API — environment template
#
# Copy to `.env` and fill in real values. `.env` must never be committed.
#   cp .env.example .env
#
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────────────────────
# Either set DATABASE_URL, or the discrete DB_* values below.
# DATABASE_URL=postgres://user:password@host:5432/ridewing

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ridewing_development
DB_USER=postgres
DB_PASSWORD=change-me
# Enable for managed Postgres that requires TLS (most cloud providers).
DB_SSL=false
# Log every SQL statement — development only, and never with real user data.
DB_LOGGING=false

# ─── Authentication ──────────────────────────────────────────────────────────
# REQUIRED. Minimum 32 characters. The server refuses to boot without it.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters

# Access tokens are short-lived; the refresh cookie carries the long-lived session.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# bcrypt cost. 12 is a sound default; raise it as hardware improves.
BCRYPT_ROUNDS=12

# ─── HTTP ────────────────────────────────────────────────────────────────────
# Comma-separated allow-list. Wildcards are rejected in production.
CORS_ORIGINS=http://localhost:3000

# Set to true ONLY when running behind a trusted proxy that sets X-Forwarded-For.
# Enabling it without a proxy lets clients spoof their IP and evade rate limits.
TRUST_PROXY=false

# Refresh cookie. Defaults to secure in production.
# COOKIE_SECURE=true
# Use 'none' (with COOKIE_SECURE=true) behind HTTPS-only public deployments.
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# ─── Limits ──────────────────────────────────────────────────────────────────
MAX_MESSAGE_LENGTH=2000
# Ride Mode uses a WebRTC mesh in V1, so keep groups small.
MAX_RIDE_PARTICIPANTS=8

# ─── WebRTC ──────────────────────────────────────────────────────────────────
# STUN is enough on permissive networks. TURN is required for riders behind
# symmetric NAT or carrier-grade NAT — which is common on mobile data.
STUN_URLS=stun:stun.l.google.com:19302

# TURN credentials are served to authenticated clients from /api/rides/ice-servers,
# so they are never embedded in the frontend bundle. Use either:
#   1) Long-lived static credentials (self-hosted coturn, or a paid provider):
# TURN_URLS=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
#   2) Cloudflare Realtime TURN (free tier, 1 TB/mo): get the key id + API token
#      from Cloudflare dashboard → Realtime → TURN. Short-lived credentials are
#      minted server-side and rotated automatically.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=

# ─── Cloudinary (media uploads) ──────────────────────────────────────────────
# All three are required to enable uploads. Get them from the Cloudinary
# dashboard → Security → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_FOLDER=ridewing

# ─── Brevo transactional email ───────────────────────────────────────────────
# API key + a verified sender email are required to send verification mail.
# Sender must be verified in Brevo → Contacts → Senders.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=RideWing

# Public address of the frontend — used to build email links.
FRONTEND_URL=http://localhost:3000
# Email token lifetimes, in minutes. Defaults: verification 15, reset 5.
# EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=15

# ─── Admin ────────────────────────────────────────────────────────────────────
# Gate for POST /api/auth/admin/register. Returns 404 while unset. Set on the
# backend host only — never in a client bundle.
# ADMIN_REGISTER_TOKEN=
# Admin notification inboxes, comma-separated.
# ADMIN_EMAILS=admin@example.com

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Key pair for signing Web Push deliveries. The PUBLIC key also goes in the
# frontend .env as NEXT_PUBLIC_VAPID_PUBLIC_KEY. Generate a fresh pair with:
#   npx web-push generate-vapid-keys --json
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com